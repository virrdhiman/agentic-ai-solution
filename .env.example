# Autonomous Agent Configuration
# Copy to .env and fill in values

# Provider: opensource | n8n | hybrid
AGENT_PROVIDER=opensource

# Open-source AI Provider (Ollama, vLLM, LM Studio, OpenAI-compatible)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=
AI_MODEL=llama3

# n8N Provider (optional)
N8N_BASE_URL=
N8N_API_KEY=

# GitHub Integration (optional)
GITHUB_TOKEN=

# Database
DATABASE_URL=sqlite+aiosqlite:///./agent.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/autonomous_agent

# Redis (optional, for distributed state)
REDIS_URL=redis://localhost:6379/0

# Environment
ENVIRONMENT=development

# Agent Configuration
MAX_RETRIES=3
TASK_TIMEOUT=3600
LOG_LEVEL=INFO
